@model UpdateCategoryDto
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="row">
    <div class="col col-md-4">
        <div class="alert alert-warning"><h5>Kategori Güncelle</h5></div>
        <hr />
        <form method="post">
            <label>Kategori Adı</label>
            <input type="hidden" asp-for="CategoryId" />
            <input type="text" asp-for="CategoryName" class="form-control" />
            <br />
            <button class="btn btn-warning"><i class="fas fa-sync-alt"></i> Güncelle</button>
        </form>
    </div>
</div>
