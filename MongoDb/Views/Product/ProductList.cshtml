@model List<ResultProductDto>
@{
    ViewData["Title"] = "ProductList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

    <div class="alert alert-primary">Ürün Listesi</div>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Görsel</th>
                <th>Ürün Adı</th>
                <th>Kategori</th>
                <th>Stok</th>
                <th>Fiyat</th>
                <th>Sil</th>
                <th>Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                count++;
                <tr>
                    <td>@count</td>
                    <td><img src="@item.ImageUrl" height="150" width="200" /></td>
                    <td>@item.ProductName</td>
                    <td>@item.Category.CategoryName</td>
                    <td>@item.Stock</td>
                    <td>@item.Price</td>
                    <td><a class="btn btn-danger" href="/Product/DeleteProduct/@item.ProductId">Sil</a></td>
                    <td><a class="btn btn-warning" href="/Product/UpdateProduct/@item.ProductId">Güncelle</a></td>
                </tr>
            }
        </tbody>
    </table>

