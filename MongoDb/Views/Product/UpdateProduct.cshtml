@model UpdateProductDto
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="row">
    <div class="col col-md-4">
        <div class="alert alert-warning"><h5>Ürün Güncelle</h5></div>
        <hr />
        <form method="post">
            <input type="hidden" asp-for="ProductId" />
            <label>Ürün Adı</label>
            <input type="text" asp-for="ProductName" class="form-control" />
            <br />
            <label>Kategori</label>
            <select asp-for="CategoryId" class="form-control" asp-items="@ViewBag.categoryList"></select>
            <br />
            <label>Stok</label>
            <input type="number" asp-for="Stock" class="form-control" />
            <br />
            <label>Fiyat</label>
            <input type="text" asp-for="Price" class="form-control" />
            <br />
            <button class="btn btn-success"><i class="fas fa-save"></i> Kaydet</button>
        </form>
    </div>
</div>
