@model UpdateProductDto
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="row">
    <div class="col col-md-12">
        <div class="alert alert-warning"><h5>Ürün Güncelle</h5></div>
        <hr />
        <form enctype="multipart/form-data" method="post">
            <div class="row">
                <div class="col col-md-4">
                    <input type="hidden" asp-for="ProductId" />
                    <label>Ürün Adı</label>
                    <input type="text" asp-for="ProductName" class="form-control" />
                    <br />
                    <label>Kategori</label>
                    <select asp-for="CategoryId" class="form-control" asp-items="@ViewBag.categoryList"></select>
                    <br />
                    <label>Stok</label>
                    <input type="number" asp-for="Stock" class="form-control" />
                    <br />
                    <label>Fiyat</label>
                    <input type="text" asp-for="Price" class="form-control" />
                </div>
                <div class="col col-md-6">
                    <div class="form-group">
                        <label class="form-label">Güncel Görsel</label>
                        <br />
                        <img src="@Model.CurrentImage" height="200" width="300" />
                    </div>
                    <div class="form-group">
                        <input type="file" asp-for="Image" class="form-control-file" />
                    </div>
                </div>
            </div>
            <br />
            <button class="btn btn-warning"><i class="fas fa-sync-alt"></i> Güncelle</button>
        </form>
    </div>
</div>
