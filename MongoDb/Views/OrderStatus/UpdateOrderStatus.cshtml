@model UpdateOrderStatusDto
@{
    ViewData["Title"] = "UpdateOrderStatus";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col col-md-4">
        <div class="alert alert-warning"><h5>Sipariş Durum Güncelle</h5></div>
        <hr />
        <form method="post">
            <label>Sipariş Durum Adı</label>
            <input type="hidden" asp-for="OrderStatusId" />
            <input type="text" asp-for="OrderStatusName" class="form-control" />
            <br />
            <button class="btn btn-warning"><i class="fas fa-sync-alt"></i> Güncelle</button>
        </form>
    </div>
</div>
